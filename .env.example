# ===================================
# Joblify Freelance Platform - Environment Variables
# ===================================

# -------------------------------------
# Database Configuration
# -------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/joblify

# -------------------------------------
# Session & Security
# -------------------------------------
# Secret key for session encryption (use a random string in production)
SESSION_SECRET=your-random-session-secret-here

# Node environment (development, production, test)
NODE_ENV=development

# -------------------------------------
# Apify Web Scraping Configuration
# -------------------------------------
# Required: Apify API token for job scraping
# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your-apify-token-here
# Alternative token variable name (APIFY_TOKEN is also supported)
# APIFY_TOKEN=your-apify-token-here

# Enable/disable X (Twitter) scraper (default: enabled)
# Set to 'false' to disable X scraper
# APIFY_ENABLE_X=true

# Optional: Override default Apify actor IDs
# APIFY_ACTOR_X=quacker/twitter-scraper
# APIFY_ACTOR_REDDIT=apify/reddit-scraper

# Optional: Apify proxy configuration
# APIFY_USE_PROXY=false
# APIFY_PROXY_GROUPS=RESIDENTIAL,DATACENTER

# -------------------------------------
# AI Configuration (for message generation)
# -------------------------------------
# OpenAI API key for AI-powered message generation
OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Poe API key (if using Poe instead of OpenAI)
# POE_API_KEY=your-poe-api-key-here

# -------------------------------------
# Email Service (Brevo/SendinBlue)
# -------------------------------------
# Brevo (formerly SendinBlue) API key for email notifications
BREVO_API_KEY=your-brevo-api-key-here

# Sender email address for notifications
BREVO_SENDER_EMAIL=noreply@yourapp.com

# Sender name for notifications
BREVO_SENDER_NAME=Joblify

# -------------------------------------
# Payment Processing (Stripe)
# -------------------------------------
# Stripe secret key for payment processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook secret for secure webhook verification
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe price IDs for subscription plans
STRIPE_PRICE_ID_PLUS=price_plus_plan_id
STRIPE_PRICE_ID_ULTRA=price_ultra_plan_id
STRIPE_PRICE_ID_LIFETIME=price_lifetime_plan_id

# -------------------------------------
# Application Configuration
# -------------------------------------
# Base URL of your application (used in emails and redirects)
BASE_URL=http://localhost:5000

# Port for the server to listen on
PORT=5000
