# ===================================
# Joblify Resume Builder - Environment Variables
# ===================================

# -------------------------------------
# Database Configuration (REQUIRED)
# -------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/joblify

# -------------------------------------
# Session & Security (REQUIRED)
# -------------------------------------
# Secret key for session encryption (use a random string in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-here

# Encryption key for two-factor authentication secrets and sensitive data
# Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=your-random-2fa-encryption-key-here

# Encryption key for AES-256 encryption of sensitive data at rest
# Generate with: openssl rand -hex 32  
ENCRYPTION_KEY=your-random-encryption-key-here

# Node environment (development, production, test)
NODE_ENV=development

# -------------------------------------
# AI Configuration (REQUIRED - for resume building)
# -------------------------------------
# Poe API key for AI-powered resume building and chat features
# Get from: https://poe.com/
# This is REQUIRED for all AI features including:
# - Resume chat builder
# - Content improvements
# - Keyword suggestions
# - ATS analysis
# - Cover letter generation
POE_API_KEY=your-poe-api-key-here
POE_API_BASE_URL=https://api.poe.com/v1

# -------------------------------------
# Email Service (OPTIONAL - for notifications)
# -------------------------------------
# Brevo (formerly SendinBlue) API key for email notifications
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Sender email address for notifications
BREVO_SENDER_EMAIL=noreply@yourapp.com

# Sender name for notifications
BREVO_SENDER_NAME=Joblify

# -------------------------------------
# Payment Processing (OPTIONAL - for subscriptions)
# -------------------------------------
# Stripe secret key for payment processing
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook secret for secure webhook verification
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe price IDs for subscription plans
# Create in: https://dashboard.stripe.com/prices
STRIPE_PLUS_PRICE_ID=price_plus_plan_id
STRIPE_ULTRA_PRICE_ID=price_ultra_plan_id
STRIPE_LIFETIME_PRICE_ID=price_lifetime_plan_id

# Stripe Customer Portal login URL
# Get from: https://dashboard.stripe.com/settings/billing/portal
# This is the public login URL where customers can access their billing portal
VITE_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/bJebJ3bnI4qMbSE4WI1B600

# -------------------------------------
# Application Configuration
# -------------------------------------
# Base URL of your application (used in emails and redirects)
BASE_URL=http://localhost:5000

# Port for the server to listen on
PORT=5000

# Enable request logging (true/false)
LOG_REQUESTS=false

# -------------------------------------
# Analytics & Monitoring (OPTIONAL - for product analytics)
# -------------------------------------
# PostHog API key for product analytics (client-side)
# Get from: https://app.posthog.com/project/settings
# Note: Must have VITE_ prefix for Vite to expose to client
VITE_POSTHOG_API_KEY=your-posthog-api-key-here
VITE_POSTHOG_HOST=https://app.posthog.com

# -------------------------------------
# Customer Support (OPTIONAL - for customer support)
# -------------------------------------
# Zendesk configuration for customer support widget (client-side)
# Get from: https://www.zendesk.com/
# Note: Must have VITE_ prefix for Vite to expose to client
VITE_ZENDESK_KEY=your-zendesk-key-here
VITE_ZENDESK_SUBDOMAIN=your-subdomain

