# ===================================
# Joblify Freelance Platform - Environment Variables
# ===================================

# -------------------------------------
# Database Configuration (REQUIRED)
# -------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/joblify

# -------------------------------------
# Session & Security (REQUIRED)
# -------------------------------------
# Secret key for session encryption (use a random string in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-here

# Node environment (development, production, test)
NODE_ENV=development

# -------------------------------------
# AI Configuration (OPTIONAL - for AI features)
# -------------------------------------
# OpenAI API key for AI-powered message generation and skill suggestions
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Poe API key (if using Poe instead of OpenAI)
# Get from: https://poe.com/
# POE_API_KEY=your-poe-api-key-here
# POE_API_BASE_URL=https://api.poe.com/v1

# -------------------------------------
# Apify Configuration (OPTIONAL - for job scraping)
# -------------------------------------
# Apify API token for Reddit and X scrapers
# Get from: https://console.apify.com/account/integrations
# Without this, job scraping will not work
APIFY_TOKEN=your-apify-api-token-here

# -------------------------------------
# Email Service (OPTIONAL - for notifications)
# -------------------------------------
# Brevo (formerly SendinBlue) API key for email notifications
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Sender email address for notifications
BREVO_SENDER_EMAIL=noreply@yourapp.com

# Sender name for notifications
BREVO_SENDER_NAME=Joblify

# -------------------------------------
# Payment Processing (OPTIONAL - for subscriptions)
# -------------------------------------
# Stripe secret key for payment processing
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook secret for secure webhook verification
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe price IDs for subscription plans
# Create in: https://dashboard.stripe.com/prices
STRIPE_PRICE_ID_PLUS=price_plus_plan_id
STRIPE_PRICE_ID_ULTRA=price_ultra_plan_id
STRIPE_PRICE_ID_LIFETIME=price_lifetime_plan_id

# -------------------------------------
# Application Configuration
# -------------------------------------
# Base URL of your application (used in emails and redirects)
BASE_URL=http://localhost:5000

# Port for the server to listen on
PORT=5000

# Enable request logging (true/false)
LOG_REQUESTS=false

# Enable scheduled job scraping (true/false)
SCHEDULE_RUNNER_ENABLED=false
