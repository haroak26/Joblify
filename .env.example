# ===================================
# Joblify Freelance Platform - Environment Variables
# ===================================

# -------------------------------------
# Database Configuration
# -------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/joblify

# -------------------------------------
# Session & Security
# -------------------------------------
# Secret key for session encryption (use a random string in production)
SESSION_SECRET=your-random-session-secret-here

# Node environment (development, production, test)
NODE_ENV=development

# -------------------------------------
# AI Configuration (for message generation)
# -------------------------------------
# OpenAI API key for AI-powered message generation
OPENAI_API_KEY=your-openai-api-key-here

# Alternative: Poe API key (if using Poe instead of OpenAI)
# POE_API_KEY=your-poe-api-key-here

# -------------------------------------
# Apify Configuration (for job scraping)
# -------------------------------------
# Apify API token for Reddit and X scrapers
APIFY_TOKEN=your-apify-api-token-here

# -------------------------------------
# Email Service (Brevo/SendinBlue)
# -------------------------------------
# Brevo (formerly SendinBlue) API key for email notifications
BREVO_API_KEY=your-brevo-api-key-here

# Sender email address for notifications
BREVO_SENDER_EMAIL=noreply@yourapp.com

# Sender name for notifications
BREVO_SENDER_NAME=Joblify

# -------------------------------------
# Payment Processing (Stripe)
# -------------------------------------
# Stripe secret key for payment processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook secret for secure webhook verification
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe price IDs for subscription plans
STRIPE_PRICE_ID_PLUS=price_plus_plan_id
STRIPE_PRICE_ID_ULTRA=price_ultra_plan_id
STRIPE_PRICE_ID_LIFETIME=price_lifetime_plan_id

# -------------------------------------
# Application Configuration
# -------------------------------------
# Base URL of your application (used in emails and redirects)
BASE_URL=http://localhost:5000

# Port for the server to listen on
PORT=5000
